# Normalize line endings to LF inside the repository. Without this, committing
# from Windows stores CRLF and every diff on a Linux host shows whole-file
# changes.
* text=auto

# These files are executed on Linux. A CRLF ending in a shebang line makes the
# kernel look for an interpreter literally named "/bin/bash\r", which fails with
# a confusing "bad interpreter" error, so pin them to LF on every platform.
*.sh text eol=lf
*.service text eol=lf

# Lockfiles are generated; collapse them in diffs and reviews.
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true

*.png binary
*.ico binary
